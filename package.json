{
  "name": "kingston-115-personal-site",
  "private": true,
  "scripts": {
    "build": "npm run build:images && npm run build:home && npm run build:css && npm run build:icons",
    "build:home": "node scripts/build-home.mjs && esbuild js/home.js --bundle --minify --format=iife --outfile=js/home.min.js --legal-comments=inline",
    "build:css": "tailwindcss -i ./css/tailwind.css -o ./css/tailwind.min.css --minify",
    "build:icons": "esbuild js/icons-entry.js --bundle --minify --format=iife --outfile=js/icons.min.js --legal-comments=inline",
    "build:images": "node scripts/build-thumbnails.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "gsap": "3.14.2",
    "lenis": "1.3.11",
    "lucide": "0.468.0",
    "sharp": "0.35.3",
    "tailwindcss": "3.4.17"
  }
}
